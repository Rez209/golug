name: Universal CI Pipeline

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]

jobs:
  security-and-build:
    runs-on: ubuntu-latest
    steps:
    - uses: actions/checkout@v3

    - name: Set up Go environment
      uses: actions/setup-go@v4
      with:
        go-version: '1.21'

    - name: Build project
      run: go build -v ./...

    - name: Cybersecurity audit (gosec)
      uses: securego/gosec@master
      with:
        args: ./...